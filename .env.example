# =============================================================================
# BASE DE DATOS — Supabase PostgreSQL
# =============================================================================

# URL de conexión pooled (para Prisma en producción con pgBouncer)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL directa (para migraciones con Prisma Migrate)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# =============================================================================
# NEXTAUTH — Autenticación de admins
# =============================================================================

# Clave secreta aleatoria (mínimo 32 caracteres)
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"

# URL base de la aplicación
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# STRIPE — Pagos
# =============================================================================

# Clave secreta del servidor (nunca exponer en el cliente)
STRIPE_SECRET_KEY="sk_test_..."

# Clave pública (se puede usar en el cliente)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Secreto del webhook (obtenido en el Dashboard de Stripe o con Stripe CLI)
STRIPE_WEBHOOK_SECRET="whsec_..."

# =============================================================================
# GMAIL — Envío de emails transaccionales vía nodemailer
# =============================================================================

# Cuenta de Gmail que envía los correos
GMAIL_USER="tu-cuenta@gmail.com"

# Contraseña de aplicación (no la contraseña normal de la cuenta)
# Generar en https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos)
GMAIL_APP_PASSWORD="your-app-password-here"

# =============================================================================
# ADMINS — Emails de los administradores del negocio
# =============================================================================

ADMIN_EMAIL_1="admin1@memoirenomade.com"
ADMIN_EMAIL_2="admin2@memoirenomade.com"

# Contraseña inicial del admin principal, usada únicamente por prisma/seed.ts
# Cámbiala tras el primer inicio de sesión
ADMIN_PASSWORD="CambiarEstaContrasena2024!"

# =============================================================================
# APP — Configuración general
# =============================================================================

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Mémoire Nomade"

# =============================================================================
# CLOUDINARY — Subida de imágenes de tours
# =============================================================================

# Nombre del cloud (no es secreto, se usa también desde el cliente)
CLOUDINARY_CLOUD_NAME=

# Clave de API (no es secreta, se usa también desde el cliente)
CLOUDINARY_API_KEY=

# Clave secreta — nunca exponer al cliente, solo se usa en el endpoint de firma
CLOUDINARY_API_SECRET=
