# next-auth/@auth/core declaran nodemailer como peerOptional (solo lo usan si
# se activa su proveedor de Email/magic-link, que este proyecto no usa). Sin
# esto, "npm install" falla en Vercel con ERESOLVE al chocar esa versión
# esperada contra el nodemailer real (^9.0.3) que usa src/lib/mailer.ts.
legacy-peer-deps=true
