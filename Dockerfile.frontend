# ── Build stage ──────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

# Variables de entorno en tiempo de build (Vite las embebe en el bundle)
ARG VITE_STRIPE_PUBLISHABLE_KEY
ARG VITE_PAYPAL_CLIENT_ID
ENV VITE_STRIPE_PUBLISHABLE_KEY=$VITE_STRIPE_PUBLISHABLE_KEY
ENV VITE_PAYPAL_CLIENT_ID=$VITE_PAYPAL_CLIENT_ID

# Instalar dependencias (capa cacheada)
COPY frontend/memoirenomade-frontend/package*.json ./
RUN npm install

# Copiar código y compilar
COPY frontend/memoirenomade-frontend/ ./
RUN npm run build

# ── Runtime stage (nginx sirve el build estático) ─────────────────────────────
FROM nginx:alpine AS runtime

# Configuración nginx con proxy al backend
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 5173

CMD ["nginx", "-g", "daemon off;"]
